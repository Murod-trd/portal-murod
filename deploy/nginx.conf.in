user nginx;
worker_processes auto;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;
events { worker_connections 512; }
http {
  server_tokens off;
  log_format privacy '$time_iso8601 status=$status bytes=$body_bytes_sent seconds=$request_time upstream=$upstream_status';
  access_log /dev/stdout privacy;
  error_log /dev/null crit;
  client_max_body_size 21m;
  client_body_timeout 20s;
  client_header_timeout 10s;
  keepalive_timeout 30s;
  limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
  limit_req_zone $binary_remote_addr zone=login:10m rate=120r/m;
  limit_req_zone $binary_remote_addr zone=uploads:10m rate=12r/m;
  limit_conn_zone $binary_remote_addr zone=connections:10m;
  server {
    listen 443 ssl;
    server_name @@SERVER_NAME@@;
    if ($host != "@@SERVER_NAME@@") { return 444; }
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;
@@NETWORK_ACL@@
    limit_req_status 429;
    # An oversized upload is refused by nginx itself; answer in the API's error shape so the SPA can show its message.
    error_page 413 @upload_too_large;
    location @upload_too_large {
      default_type application/json;
      add_header Cache-Control "no-store" always;
      add_header X-Content-Type-Options "nosniff" always;
      return 413 '{"code":"UPLOAD_SIZE_LIMIT"}';
    }
    limit_conn connections 30;
    location ^~ /api/internal/ { return 404; }
    location = /api/v1/auth/login {
      limit_req zone=login burst=120 nodelay;
      proxy_pass http://app:8000;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Portal-Proxy-Key "@@EDGE_PROXY_TOKEN@@";
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
    location = /api/v1/files {
      limit_req zone=uploads burst=3 nodelay;
      proxy_pass http://app:8000;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Portal-Proxy-Key "@@EDGE_PROXY_TOKEN@@";
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
    location / {
      limit_req zone=general burst=50 nodelay;
      proxy_pass http://app:8000;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Portal-Proxy-Key "@@EDGE_PROXY_TOKEN@@";
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
  }
}
