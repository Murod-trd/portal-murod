# Reference only. Standard installation generates .deploy/portal.env using portalctl configure.
# Do not copy real values into git. Python itself reads process environment, not this file.
APP_ENV=production
APP_ORIGIN=https://portal.company.internal
ALLOWED_HOSTS=portal.company.internal
DB_ENGINE=postgres
POSTGRES_HOST=postgres
POSTGRES_DB=portal
POSTGRES_USER=portal_app
POSTGRES_PASSWORD=GENERATED_BY_PORTALCTL
POSTGRES_OWNER_PASSWORD=GENERATED_BY_PORTALCTL
POSTGRES_ADMIN_PASSWORD=GENERATED_BY_PORTALCTL
DJANGO_SECRET_KEY=GENERATED_BY_PORTALCTL
WORKER_TOKEN=GENERATED_BY_PORTALCTL
EDGE_PROXY_TOKEN=GENERATED_BY_PORTALCTL
STORAGE_DRIVER=filesystem
PRIVATE_STORAGE_DIR=/var/lib/portal/files
REQUIRE_MFA=none
REQUIRE_PASSWORD_CHANGE=false
TRUST_HTTPS_PROXY=true
CLAMAV_HOST=clamav
OCR_LANGUAGES=tur+uzb+eng+rus+uzb_cyrl
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_TOTAL_BYTES=2147483648
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=43200
# Images and release are generated from deploy/images.lock.json and RELEASE.
# Advanced S3 deployment is separate from the standard single-server profile.
